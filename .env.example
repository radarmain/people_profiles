# App
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_BASE_URL=http://127.0.0.1:8080
ENVIRONMENT=local
# Comma-separated Google login emails that can open /admin
ADMIN_EMAILS=

# Storage: local (JSON files) or dynamodb
STORAGE_BACKEND=local
LOCAL_DATA_DIR=.data

# DynamoDB (when STORAGE_BACKEND=dynamodb)
AWS_PROFILE=concrete
AWS_REGION=us-east-1
# Bedrock Knowledge Base must be queried in the region where it was created
AWS_KB_REGION=us-east-1
# Leave empty to use AWS DynamoDB (same tables as Lambda). Set only for DynamoDB Local.
DYNAMODB_ENDPOINT=
DYNAMODB_USERS_TABLE=_user_profiles_users
DYNAMODB_AGENCIES_TABLE=_user_profiles_agencies

# Offload enrich/summary jobs to AWS (SQS + Lambda). Requires deploy script + IAM sqs:SendMessage.
_USER_PROFILES_OFFLOAD=false
# Keep false so "Analyze role" runs in the web app and fills work_profile before redirect.
_USER_PROFILES_OFFLOAD_SUMMARIZE=false
_USER_PROFILES_JOBS_QUEUE_URL=
_USER_PROFILES_WORKER_FUNCTION_NAME=_user_profiles_worker
_USER_PROFILES_ARTIFACT_BUCKET=
_USER_PROFILES_STACK_NAME=user-profiles-stack
_USER_PROFILES_PREFIX=_user_profiles

# Google OAuth (Web application client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override (space-separated). Default includes People API org/phone scopes + calendar.readonly.
# GOOGLE_OAUTH_SCOPES=openid email profile https://www.googleapis.com/auth/user.organization.read
# Set true once if users lack People API tokens; or use /auth/google/relink on profile page
# GOOGLE_OAUTH_PROMPT_CONSENT=false
# Calendar meeting network (associations + same-domain provisional users)
GOOGLE_CALENDAR_ENABLED=true
CALENDAR_NETWORK_ENABLED=true
CALENDAR_NETWORK_CREATE_PROVISIONAL=true
CALENDAR_NETWORK_MAX_ATTENDEES_FOR_NETWORK=500
CALENDAR_NETWORK_MAX_NEW_PROVISIONALS_PER_SYNC=25

# Slack OAuth (user token for profile enrichment)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_USER_SCOPES=users:read,users:read.email,users.profile:read,team:read,channels:read

# HiBob API service user (server-side only)
HIBOB_SERVICE_USER_ID=
HIBOB_SERVICE_USER_TOKEN=
HIBOB_API_BASE=https://api.hibob.com/v1

# LLM summary (optional locally; uses AWS profile when set)
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
LLM_FALLBACK_WITHOUT_BEDROCK=true

# LinkedIn smart lookup (web search + Bedrock disambiguation)
LINKEDIN_LOOKUP_ENABLED=true
LINKEDIN_LOOKUP_MIN_CONFIDENCE=0.72
# Recommended: Tavily for reliable search; falls back to DuckDuckGo if unset
WEB_SEARCH_PROVIDER=auto
TAVILY_API_KEY=

# Bedrock Knowledge Base (Retrieve API — profile enrichment; uses AWS_KB_REGION)
BEDROCK_KNOWLEDGE_BASE_ID=
# managed (Bedrock Managed KB) | vector (OpenSearch/etc.) | auto
BEDROCK_KB_SEARCH_MODE=managed
BEDROCK_KB_NUMBER_OF_RESULTS=8
BEDROCK_KB_MAX_QUERIES=4
BEDROCK_KB_MAX_MERGED_RESULTS=12
